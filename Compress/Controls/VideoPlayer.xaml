<UserControl x:Class="Compress.Controls.VideoPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="ControlsGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#B3000000" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>
    <Border x:Name="Card" Background="Black" CornerRadius="16"
            SizeChanged="Card_SizeChanged" MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <Grid x:Name="ClipHost">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="ControlsRow" Height="0" />
            </Grid.RowDefinitions>

            <!-- Poster + video; also the live source for VisualBrush previews (Shorts page) -->
            <Grid x:Name="Surface" Background="Black">
                <Image x:Name="PosterImage" Stretch="Uniform" />
                <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Uniform"
                              MediaOpened="Media_MediaOpened" MediaEnded="Media_MediaEnded" MediaFailed="Media_MediaFailed" />
            </Grid>

            <Border Background="Transparent" MouseLeftButtonUp="Surface_Click" />

            <Border x:Name="BigPlay" Width="68" Height="68" CornerRadius="34" Background="#99000000" IsHitTestVisible="False">
                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="24" Foreground="White" Margin="4,0,0,0" />
            </Border>

            <Border x:Name="PreviewUnavailable" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0"
                    Background="#CC0A0A0A" CornerRadius="10" Padding="12,7" IsHitTestVisible="False">
                <TextBlock Text="Preview not supported for this format. Processing still works." FontSize="12" Foreground="{StaticResource Text2}" />
            </Border>

            <Border x:Name="Preparing" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#CC0A0A0A" CornerRadius="10" Padding="14,8" IsHitTestVisible="False">
                <TextBlock Text="Preparing preview…" FontSize="12.5" Foreground="{StaticResource Text2}" />
            </Border>

            <!-- Editing layer drawn over the video, below the controls -->
            <ContentPresenter x:Name="OverlayHost" />

            <Grid x:Name="Controls" VerticalAlignment="Bottom" Background="{StaticResource ControlsGradient}">
                <StackPanel x:Name="ControlsPanel" Margin="14,36,14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PlayButton" Style="{StaticResource PlayerButton}" Content="&#xE768;" Click="PlayButton_Click" />
                        <TextBlock x:Name="TimeText" Grid.Column="1" Text="0:00 / 0:00" Foreground="White" FontSize="13"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                        <Button x:Name="MuteButton" Grid.Column="3" Style="{StaticResource PlayerButton}" Content="&#xE767;" Click="MuteButton_Click" />
                        <Slider x:Name="VolumeSlider" Grid.Column="4" Style="{StaticResource MediaSlider}" Width="80" Minimum="0" Maximum="1"
                                Value="0.8" VerticalAlignment="Center" Margin="4,0,4,0" ValueChanged="VolumeSlider_ValueChanged" />
                    </Grid>
                    <Grid x:Name="SeekHost" Margin="4,6,4,0">
                        <Slider x:Name="SeekSlider" Style="{StaticResource MediaSlider}" Minimum="0" Maximum="1" SizeChanged="SeekSlider_SizeChanged" />
                        <Border x:Name="RangeHighlight" Height="4" CornerRadius="2" Background="{StaticResource Accent}" Opacity="0.85"
                                HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
