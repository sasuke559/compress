<UserControl x:Class="Compress.Pages.ShortsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Compress.Controls">
    <Grid>
        <!-- ================= Empty state ================= -->
        <Grid x:Name="EmptyView">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,30">
                <controls:DropZone Title="Drop a clip to make a short" ButtonText="Select Video" Pick="SelectVideo_Click" />
                <TextBlock x:Name="EmptyError" Foreground="{StaticResource Danger}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                           MaxWidth="460" HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- ================= Editor ================= -->
        <Grid x:Name="EditorView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Source and preview sit side by side on wide screens and stacked on tall (portrait) screens -->
            <Grid x:Name="Stage" Margin="30,22,30,20" SizeChanged="Stage_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Source with crop and HUD boxes -->
                <StackPanel x:Name="SourceColumn" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Margin="2,0,2,10">
                        <TextBlock Text="SOURCE" Style="{StaticResource Label}" Margin="0" />
                        <TextBlock Text="Drag the boxes onto your HUD" FontSize="12" Foreground="{StaticResource Text3}" HorizontalAlignment="Right" />
                    </Grid>
                    <controls:VideoPlayer x:Name="Player" Width="640" Height="434" />
                    <Grid Margin="4,12,4,0">
                        <TextBlock x:Name="FileTitle" Foreground="#D4D4D4" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                    </Grid>
                    <TextBlock x:Name="FileMeta" Foreground="{StaticResource Text3}" FontSize="12" Margin="4,4,4,0" />
                </StackPanel>

                <!-- 9:16 live preview -->
                <StackPanel x:Name="PhoneColumn" Grid.Column="1" Grid.RowSpan="2" Margin="28,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Margin="2,0,2,10">
                        <TextBlock Text="9:16 PREVIEW" Style="{StaticResource Label}" Margin="0" />
                        <TextBlock Text="1080 × 1920" FontSize="12" Foreground="{StaticResource Text3}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border x:Name="PhoneFrame" Width="300" Height="533" CornerRadius="22" Background="Black"
                            BorderBrush="{StaticResource Line2}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.5" Color="Black" />
                        </Border.Effect>
                        <Grid x:Name="PhoneHost" SizeChanged="PhoneHost_SizeChanged">
                            <Canvas x:Name="PhoneCanvas" Background="Transparent" MouseLeftButtonDown="PhoneCanvas_MouseDown" />
                            <Canvas x:Name="AppOverlayLayer" IsHitTestVisible="False" />
                            <Canvas x:Name="GuideLayer" IsHitTestVisible="False">
                                <Rectangle x:Name="GuideV" Width="1" Fill="{StaticResource Accent}" Visibility="Collapsed" />
                                <Rectangle x:Name="GuideH" Height="1" Fill="{StaticResource Accent}" Visibility="Collapsed" />
                            </Canvas>
                        </Grid>
                    </Border>
                    <TextBlock Text="Drag to move · corners or mouse wheel to resize" FontSize="11.5" Foreground="{StaticResource Text3}"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>

            <!-- Side panel -->
            <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <Grid Margin="20,26,20,24">

                        <!-- Settings -->
                        <StackPanel x:Name="SettingsPanel">
                            <Grid Margin="0,0,0,18">
                                <TextBlock Text="Vertical short" Style="{StaticResource Heading}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="UndoButton" Style="{StaticResource HeaderIconButton}" Content="&#xE7A7;" ToolTip="Undo (Ctrl+Z)" Click="Undo_Click" />
                                    <Button x:Name="RedoButton" Style="{StaticResource HeaderIconButton}" Content="&#xE7A6;" ToolTip="Redo (Ctrl+Y)" Click="Redo_Click" />
                                </StackPanel>
                            </Grid>

                            <!-- Game -->
                            <TextBlock Text="GAME" Style="{StaticResource Label}" />
                            <WrapPanel x:Name="GamePanel" Margin="0,0,-8,4" />
                            <Button x:Name="DeletePresetButton" Style="{StaticResource LinkButton}" FontSize="12" HorizontalAlignment="Left"
                                    Margin="-4,-4,0,8" Click="DeletePreset_Click" Visibility="Collapsed" />

                            <!-- Frame -->
                            <TextBlock Text="GAMEPLAY" Style="{StaticResource Label}" Margin="0,6,0,8" />
                            <Border Style="{StaticResource SegmentHost}">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="FrameFull" Style="{StaticResource Segment}" GroupName="ShortsFrame" Content="Full" IsChecked="True"
                                                 Checked="Framing_Checked" ToolTip="Gameplay fills the whole screen (zoomed in on the middle)" />
                                    <RadioButton x:Name="FramePortrait" Style="{StaticResource Segment}" GroupName="ShortsFrame" Content="4:5"
                                                 Checked="Framing_Checked" ToolTip="Tall gameplay with a little room above and below" />
                                    <RadioButton x:Name="FrameSquare" Style="{StaticResource Segment}" GroupName="ShortsFrame" Content="1:1"
                                                 Checked="Framing_Checked" ToolTip="Square gameplay, room for HUD above and below" />
                                    <RadioButton x:Name="FrameWide" Style="{StaticResource Segment}" GroupName="ShortsFrame" Content="16:9"
                                                 Checked="Framing_Checked" ToolTip="The whole 16:9 picture, HUD above and below" />
                                </UniformGrid>
                            </Border>

                            <StackPanel x:Name="BackgroundSection">
                                <TextBlock Text="BACKGROUND" Style="{StaticResource Label}" />
                                <Border Style="{StaticResource SegmentHost}">
                                    <UniformGrid Rows="1">
                                        <RadioButton x:Name="BgBlur" Style="{StaticResource Segment}" GroupName="ShortsBg" Content="Blurred gameplay" IsChecked="True"
                                                     Checked="Background_Checked" />
                                        <RadioButton x:Name="BgBlack" Style="{StaticResource Segment}" GroupName="ShortsBg" Content="Black" Checked="Background_Checked" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>

                            <!-- Target app -->
                            <TextBlock Text="POSTING ON" Style="{StaticResource Label}" Margin="0,6,0,8" />
                            <Border Style="{StaticResource SegmentHost}" Margin="0,0,0,10">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="PlatformTikTok" Style="{StaticResource Segment}" GroupName="ShortsPlatform" Content="TikTok" IsChecked="True"
                                                 Checked="Platform_Checked" />
                                    <RadioButton x:Name="PlatformReels" Style="{StaticResource Segment}" GroupName="ShortsPlatform" Content="Reels"
                                                 Checked="Platform_Checked" />
                                    <RadioButton x:Name="PlatformShorts" Style="{StaticResource Segment}" GroupName="ShortsPlatform" Content="Shorts"
                                                 Checked="Platform_Checked" />
                                </UniformGrid>
                            </Border>
                            <Grid Margin="2,0,0,8">
                                <StackPanel Margin="0,0,50,0">
                                    <TextBlock Text="Show app interface" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Text="Buttons, caption and menu over the preview, so nothing important ends up underneath. Not exported."
                                               FontSize="12" Foreground="{StaticResource Text3}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="SafeZoneSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Click="SafeZoneSwitch_Click" />
                            </Grid>

                            <!-- Covered HUD warnings -->
                            <Border x:Name="CoverageWarning" Background="{StaticResource DangerSoft}" CornerRadius="10" Padding="12,9" Margin="0,4,0,8"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Danger}"
                                               VerticalAlignment="Top" Margin="0,2,10,0" />
                                    <TextBlock x:Name="CoverageText" Grid.Column="1" FontSize="12" Foreground="{StaticResource Danger}" TextWrapping="Wrap" LineHeight="17" />
                                </Grid>
                            </Border>

                            <!-- HUD elements -->
                            <Grid Margin="0,6,0,8">
                                <TextBlock Text="HUD ELEMENTS" Style="{StaticResource Label}" Margin="0" VerticalAlignment="Center" />
                                <Button Style="{StaticResource LinkButton}" FontSize="12" HorizontalAlignment="Right" Margin="0,-6,-4,-6"
                                        ToolTip="Place every element above or below the gameplay, clear of the app buttons and caption" Click="AutoArrange_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A1;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0" />
                                        <TextBlock Text="Auto arrange" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <StackPanel x:Name="ElementList" />
                            <TextBlock x:Name="NoElementsText" Style="{StaticResource CardText}" Margin="2,0,2,10"
                                       Text="No HUD elements. Pick a game above or add one, then drag its box onto the HUD in the source." />
                            <Button Style="{StaticResource GhostButton}" Height="38" Margin="0,2,0,0" Click="AddElement_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Add element" />
                                </StackPanel>
                            </Button>

                            <!-- Selected element -->
                            <Border x:Name="SelectedPanel" Style="{StaticResource Tile}" Margin="0,12,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Name="SelectedTitle" Style="{StaticResource TileLabel}" />
                                        <TextBlock x:Name="SelectedSizeText" Style="{StaticResource TileLabel}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="SizeSlider" Style="{StaticResource MediaSlider}" Minimum="0.08" Maximum="1" Margin="0,10,0,6"
                                            ValueChanged="SizeSlider_ValueChanged" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Style="{StaticResource ChipButton}" Content="Center" Click="CenterElement_Click" ToolTip="Center horizontally" />
                                        <Button Style="{StaticResource ChipButton}" Content="Duplicate" Click="DuplicateElement_Click" />
                                        <Button Style="{StaticResource ChipButton}" Content="Delete" Click="DeleteElement_Click" ToolTip="Delete (Del)" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Clip -->
                            <TextBlock Text="CLIP" Style="{StaticResource Label}" Margin="0,20,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBox x:Name="StartBox" Style="{StaticResource TimeInput}" Width="Auto" KeyDown="TimeBox_KeyDown" LostFocus="TimeBox_LostFocus"
                                             ToolTip="Start" />
                                    <Button Style="{StaticResource LinkButton}" Content="Start at playhead  (I)" FontSize="12" HorizontalAlignment="Left"
                                            Margin="-4,4,0,0" Click="SetStart_Click" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBox x:Name="EndBox" Style="{StaticResource TimeInput}" Width="Auto" KeyDown="TimeBox_KeyDown" LostFocus="TimeBox_LostFocus"
                                             ToolTip="End" />
                                    <Button Style="{StaticResource LinkButton}" Content="End at playhead  (O)" FontSize="12" HorizontalAlignment="Right"
                                            Margin="0,4,-4,0" Click="SetEnd_Click" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="LengthNote" Style="{StaticResource CardText}" Margin="2,4,2,0" Visibility="Collapsed" />

                            <Grid Margin="2,16,0,12">
                                <StackPanel Margin="0,0,50,0">
                                    <TextBlock Text="Limit to 60 fps" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Text="The apps play at most 60 fps." FontSize="12" Foreground="{StaticResource Text3}" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="Limit60Switch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Click="Options_Changed" />
                            </Grid>
                            <Grid Margin="2,0,0,16">
                                <StackPanel Margin="0,0,50,0">
                                    <TextBlock Text="Remove audio" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Text="Export a silent clip, e.g. to add music in the app." FontSize="12" Foreground="{StaticResource Text3}"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="RemoveAudioSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Click="Options_Changed" />
                            </Grid>

                            <Border Style="{StaticResource Tile}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Output" Style="{StaticResource TileLabel}" />
                                        <TextBlock x:Name="SummaryOutput" Text="—" Style="{StaticResource TileValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="Estimated size" Style="{StaticResource TileLabel}" HorizontalAlignment="Right" />
                                        <TextBlock x:Name="SummarySize" Text="—" Style="{StaticResource TileValue}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Button x:Name="ExportButton" Style="{StaticResource WhiteButton}" AutomationProperties.Name="Export short" Click="ExportButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Export short" />
                                    <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="12" Margin="10,1,0,0" />
                                </StackPanel>
                            </Button>

                            <!-- Save preset -->
                            <Button x:Name="SavePresetLink" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,10,0,0" Click="SavePresetLink_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Save layout as preset" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="SavePresetPanel" Style="{StaticResource Tile}" Margin="0,10,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="PRESET NAME" Style="{StaticResource Label}" />
                                    <TextBox x:Name="PresetNameBox" Style="{StaticResource Input}" FontSize="13" KeyDown="PresetNameBox_KeyDown" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Style="{StaticResource ChipButton}" Content="Cancel" Click="CancelPreset_Click" />
                                        <Button Style="{StaticResource ChipButton}" Content="Save" Margin="0" Click="SavePreset_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource LinkButton}" Content="Choose another video" HorizontalAlignment="Center" Margin="0,4,0,0"
                                    Click="SelectVideo_Click" />

                            <Border Style="{StaticResource Tile}" Margin="0,24,0,0" Background="Transparent">
                                <StackPanel>
                                    <TextBlock Text="SHORTCUTS" Style="{StaticResource Label}" />
                                    <TextBlock Foreground="{StaticResource Text3}" FontSize="12" LineHeight="20" TextWrapping="Wrap"
                                               Text="Space  play / pause&#10;I / O  start / end at playhead&#10;← / →  1 second back / forward&#10;Del  delete selected element&#10;Ctrl+Z / Ctrl+Y  undo / redo" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Progress -->
                        <controls:ProgressView x:Name="ProgressPanel" Title="Exporting" Visibility="Collapsed" CancelRequested="Progress_CancelRequested" />

                        <!-- Done -->
                        <StackPanel x:Name="DonePanel" Visibility="Collapsed">
                            <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource AccentSoft}" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource Accent}" />
                            </Border>
                            <TextBlock Text="Short ready" Style="{StaticResource Heading}" Margin="0,16,0,0" />
                            <TextBlock x:Name="DoneFileText" Style="{StaticResource CardText}" Margin="0,6,0,20" />

                            <Border Style="{StaticResource Tile}" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Length" Style="{StaticResource TileLabel}" />
                                        <TextBlock x:Name="DoneLength" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="28"
                                                   Foreground="{StaticResource Accent}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="Size" Style="{StaticResource TileLabel}" HorizontalAlignment="Right" />
                                        <TextBlock x:Name="DoneSize" Style="{StaticResource TileValue}" FontSize="18" HorizontalAlignment="Right" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="DoneDetails" Style="{StaticResource CardText}" Foreground="{StaticResource Text3}" Margin="2,10,2,0" />

                            <Button Style="{StaticResource WhiteButton}" Margin="0,20,0,0" Click="ShowInFolder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xED25;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="Show in folder" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Margin="0,10,0,0" Click="CopyFile_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="CopyFileIcon" Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock x:Name="CopyFileText" Text="Copy file" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Margin="0,10,0,0" Click="SendToCompress_Click"
                                    ToolTip="Open the short on the Compress page">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73F;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Accent}" Margin="0,0,10,0" />
                                    <TextBlock Text="Compress this short" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource LinkButton}" Content="Back to the editor" HorizontalAlignment="Center" Margin="0,10,0,0" Click="BackToSettings_Click" />
                        </StackPanel>

                        <!-- Error -->
                        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                            <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource DangerSoft}" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Danger}" />
                            </Border>
                            <TextBlock x:Name="ErrorTitle" Text="Export failed" Style="{StaticResource Heading}" Margin="0,16,0,0" TextWrapping="Wrap" />
                            <Border Style="{StaticResource Tile}" Margin="0,16,0,0">
                                <TextBox x:Name="ErrorText" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource Text2}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" MaxHeight="260"
                                         VerticalScrollBarVisibility="Auto" />
                            </Border>
                            <Button Style="{StaticResource WhiteButton}" Content="Back" Margin="0,20,0,0" Click="BackToSettings_Click" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
