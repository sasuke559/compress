<UserControl x:Class="Compress.Pages.CompressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Compress.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <!-- ================= Empty state ================= -->
        <Grid x:Name="EmptyView">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,30">
                <controls:DropZone Title="Drop a video to compress" ButtonText="Select Video" Pick="SelectVideo_Click" />
                <TextBlock x:Name="EmptyError" Foreground="{StaticResource Danger}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                           MaxWidth="460" HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- ================= Editor ================= -->
        <Grid x:Name="EditorView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Video -->
            <Grid x:Name="VideoArea" Margin="34,36,34,24" SizeChanged="VideoArea_SizeChanged">
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                    <Grid HorizontalAlignment="Center">
                        <controls:VideoPlayer x:Name="Player" Width="640" Height="360" />
                        <!-- Original / Compressed toggle, layered over the video -->
                        <Border x:Name="CompareBar" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="14"
                                Background="#D90A0A0A" CornerRadius="10" Padding="3" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <UniformGrid Rows="1" Width="210">
                                <RadioButton x:Name="CompareOriginal" Style="{StaticResource Segment}" GroupName="CompressCompare" Content="Original" Checked="Compare_Checked" />
                                <RadioButton x:Name="CompareResult" Style="{StaticResource Segment}" GroupName="CompressCompare" Content="Compressed" Checked="Compare_Checked" />
                            </UniformGrid>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="FileTitle" HorizontalAlignment="Center" Margin="0,16,0,0" Foreground="#D4D4D4" FontSize="14"
                               TextTrimming="CharacterEllipsis" MaxWidth="{Binding ActualWidth, ElementName=Player}" />
                    <TextBlock x:Name="FileMeta" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{StaticResource Text3}" FontSize="12.5" />

                    <!-- Quick trim -->
                    <Border x:Name="TrimBar" Style="{StaticResource Tile}" Margin="0,18,0,0" Padding="14,8" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C6;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Text2}" Margin="0,0,8,0" />
                            <TextBlock Text="Trim" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Button Style="{StaticResource ChipButton}" Content="Set start" ToolTip="Set start to the current position (I)" Click="SetTrimStart_Click" />
                            <TextBlock x:Name="TrimStartText" Text="0:00.0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" MinWidth="44" />
                            <TextBlock Text="→" Foreground="{StaticResource Text3}" VerticalAlignment="Center" Margin="6,0,10,0" />
                            <TextBlock x:Name="TrimEndText" Text="0:00.0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="44" />
                            <Button Style="{StaticResource ChipButton}" Content="Set end" ToolTip="Set end to the current position (O)" Click="SetTrimEnd_Click" />
                            <TextBlock x:Name="TrimLengthText" Foreground="{StaticResource Text3}" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                            <Button x:Name="TrimResetButton" Style="{StaticResource LinkButton}" Content="Reset" FontSize="12.5" Visibility="Collapsed" Click="TrimReset_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Side panel -->
            <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <Grid Margin="20,26,20,24">

                        <!-- Settings -->
                        <StackPanel x:Name="SettingsPanel">
                            <TextBlock Text="Compress" Style="{StaticResource Heading}" Margin="0,0,0,18" />

                            <RadioButton x:Name="MediumRadio" Style="{StaticResource PresetCard}" GroupName="CompressPreset" IsChecked="True" Checked="Options_Changed">
                                <StackPanel>
                                    <TextBlock Text="Medium" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Balanced quality, size, and speed." Style="{StaticResource CardText}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="HighRadio" Style="{StaticResource PresetCard}" GroupName="CompressPreset" Checked="Options_Changed">
                                <StackPanel>
                                    <TextBlock Text="High" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Sharper image, larger file, and a slower process." Style="{StaticResource CardText}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="LowRadio" Style="{StaticResource PresetCard}" GroupName="CompressPreset" Checked="Options_Changed">
                                <StackPanel>
                                    <TextBlock Text="Low" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Fastest process, smallest file, lowest quality. Great for messages." Style="{StaticResource CardText}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TargetRadio" Style="{StaticResource PresetCard}" GroupName="CompressPreset" Checked="Options_Changed">
                                <StackPanel>
                                    <TextBlock Text="Target size" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Hit an exact file size, e.g. for Discord or email limits." Style="{StaticResource CardText}" />
                                    <StackPanel Visibility="{Binding IsChecked, ElementName=TargetRadio, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                        <Grid>
                                            <TextBox x:Name="TargetBox" Style="{StaticResource Input}" Text="10" TextChanged="TargetBox_TextChanged" />
                                            <TextBlock Text="MB" Foreground="{StaticResource Text3}" FontSize="13" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" />
                                        </Grid>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Style="{StaticResource ChipButton}" Content="8 MB" Tag="8" Click="TargetChip_Click" />
                                            <Button Style="{StaticResource ChipButton}" Content="10 MB" Tag="10" Click="TargetChip_Click" />
                                            <Button Style="{StaticResource ChipButton}" Content="25 MB" Tag="25" Click="TargetChip_Click" />
                                            <Button Style="{StaticResource ChipButton}" Content="50 MB" Tag="50" Click="TargetChip_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>

                            <!-- Advanced -->
                            <ToggleButton x:Name="AdvancedToggle" Style="{StaticResource Disclosure}" Content="Advanced settings" Margin="2,2,4,4" />
                            <StackPanel Visibility="{Binding IsChecked, ElementName=AdvancedToggle, Converter={StaticResource BoolToVis}}" Margin="0,6,0,4">
                                <TextBlock Text="CODEC" Style="{StaticResource Label}" />
                                <Border Style="{StaticResource SegmentHost}">
                                    <UniformGrid Rows="1">
                                        <RadioButton x:Name="CodecH264" Style="{StaticResource Segment}" GroupName="CompressCodec" Content="H.264" IsChecked="True" Checked="Options_Changed"
                                                     ToolTip="Plays everywhere" />
                                        <RadioButton x:Name="CodecH265" Style="{StaticResource Segment}" GroupName="CompressCodec" Content="H.265" Checked="Options_Changed"
                                                     ToolTip="About 40% smaller at the same quality, but not every app can play it" />
                                    </UniformGrid>
                                </Border>

                                <TextBlock Text="RESOLUTION" Style="{StaticResource Label}" />
                                <Border Style="{StaticResource SegmentHost}">
                                    <UniformGrid Rows="1">
                                        <RadioButton x:Name="ResAuto" Style="{StaticResource Segment}" GroupName="CompressRes" Content="Auto" IsChecked="True" Checked="Options_Changed" />
                                        <RadioButton x:Name="Res1080" Style="{StaticResource Segment}" GroupName="CompressRes" Content="1080p" Checked="Options_Changed" />
                                        <RadioButton x:Name="Res720" Style="{StaticResource Segment}" GroupName="CompressRes" Content="720p" Checked="Options_Changed" />
                                        <RadioButton x:Name="Res480" Style="{StaticResource Segment}" GroupName="CompressRes" Content="480p" Checked="Options_Changed" />
                                    </UniformGrid>
                                </Border>

                                <TextBlock Text="FRAME RATE" Style="{StaticResource Label}" />
                                <Border Style="{StaticResource SegmentHost}">
                                    <UniformGrid Rows="1">
                                        <RadioButton x:Name="FpsOriginal" Style="{StaticResource Segment}" GroupName="CompressFps" Content="Original" IsChecked="True" Checked="Options_Changed" />
                                        <RadioButton x:Name="Fps60" Style="{StaticResource Segment}" GroupName="CompressFps" Content="60" Checked="Options_Changed" />
                                        <RadioButton x:Name="Fps30" Style="{StaticResource Segment}" GroupName="CompressFps" Content="30" Checked="Options_Changed" />
                                    </UniformGrid>
                                </Border>

                                <Grid Margin="0,2,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Remove audio" FontSize="13.5" FontWeight="SemiBold" />
                                        <TextBlock Text="Export a silent video." FontSize="12" Foreground="{StaticResource Text3}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="RemoveAudioSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Click="Options_Changed" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,50,0">
                                        <TextBlock Text="GPU acceleration" FontSize="13.5" FontWeight="SemiBold" />
                                        <TextBlock x:Name="HardwareHint" Text="Detecting…" FontSize="12" Foreground="{StaticResource Text3}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="HardwareSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsEnabled="False" Click="HardwareSwitch_Click" />
                                </Grid>
                            </StackPanel>

                            <controls:SaveModeSelector x:Name="SaveMode" Margin="0,8,0,0"
                                                       NewFileHint="The original stays as it is; the smaller copy is saved next to it." />

                            <!-- Estimate -->
                            <Border Style="{StaticResource Tile}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Estimated size" Style="{StaticResource TileLabel}" />
                                        <TextBlock x:Name="EstimateText" Text="—" Style="{StaticResource TileValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="Output" Style="{StaticResource TileLabel}" HorizontalAlignment="Right" />
                                        <TextBlock x:Name="EstimateSub" Text="—" Style="{StaticResource TileValue}" FontSize="13" Foreground="{StaticResource Text2}"
                                                   HorizontalAlignment="Right" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="PlanNote" Style="{StaticResource CardText}" Margin="2,-4,2,12" Visibility="Collapsed" />

                            <Button x:Name="CompressButton" Style="{StaticResource WhiteButton}" AutomationProperties.Name="Compress" Click="CompressButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Compress" />
                                    <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="12" Margin="10,1,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource LinkButton}" Content="Choose another video" HorizontalAlignment="Center" Margin="0,10,0,0"
                                    Click="SelectVideo_Click" />
                        </StackPanel>

                        <!-- Progress -->
                        <controls:ProgressView x:Name="ProgressPanel" Title="Compressing" Visibility="Collapsed" CancelRequested="Progress_CancelRequested" />

                        <!-- Done -->
                        <StackPanel x:Name="DonePanel" Visibility="Collapsed">
                            <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource AccentSoft}" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource Accent}" />
                            </Border>
                            <TextBlock Text="Compression complete" Style="{StaticResource Heading}" Margin="0,16,0,0" />
                            <TextBlock x:Name="DoneFileText" Style="{StaticResource CardText}" Margin="0,6,0,20" />

                            <Border Style="{StaticResource Tile}" Padding="16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Before" Style="{StaticResource TileLabel}" />
                                            <TextBlock x:Name="BeforeText" Style="{StaticResource TileValue}" Foreground="{StaticResource Text2}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="&#xE72A;" Style="{StaticResource Icon}" Foreground="{StaticResource Text3}" FontSize="13" Margin="10,14,10,0" />
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="After" Style="{StaticResource TileLabel}" HorizontalAlignment="Right" />
                                            <TextBlock x:Name="AfterText" Style="{StaticResource TileValue}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource Line}" Margin="0,14" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ReductionText" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="34"
                                                   Foreground="{StaticResource Accent}" />
                                        <TextBlock x:Name="ReductionLabel" Text="smaller" Foreground="{StaticResource Text2}" FontSize="14" VerticalAlignment="Bottom" Margin="8,0,0,7" />
                                    </StackPanel>
                                    <TextBlock x:Name="DoneDetails" Foreground="{StaticResource Text3}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="DoneWarning" Style="{StaticResource CardText}" Margin="2,12,2,0" Visibility="Collapsed" />

                            <Button Style="{StaticResource WhiteButton}" Margin="0,20,0,0" Click="ShowInFolder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xED25;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="Show in folder" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Margin="0,10,0,0" Click="CopyFile_Click"
                                    ToolTip="Copies the file so you can paste it straight into Discord, WhatsApp Web or an email">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="CopyFileIcon" Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock x:Name="CopyFileText" Text="Copy file (paste into Discord)" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Content="Try other settings" Margin="0,10,0,0" Click="BackToSettings_Click" />
                            <Button Style="{StaticResource LinkButton}" Content="Compress another video" HorizontalAlignment="Center" Margin="0,10,0,0" Click="SelectVideo_Click" />
                        </StackPanel>

                        <!-- Error -->
                        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                            <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource DangerSoft}" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Danger}" />
                            </Border>
                            <TextBlock x:Name="ErrorTitle" Text="Compression failed" Style="{StaticResource Heading}" Margin="0,16,0,0" TextWrapping="Wrap" />
                            <Border Style="{StaticResource Tile}" Margin="0,16,0,0">
                                <TextBox x:Name="ErrorText" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource Text2}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" MaxHeight="260"
                                         VerticalScrollBarVisibility="Auto" />
                            </Border>
                            <Button Style="{StaticResource WhiteButton}" Content="Back to settings" Margin="0,20,0,0" Click="BackToSettings_Click" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
