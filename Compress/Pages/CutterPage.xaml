<UserControl x:Class="Compress.Pages.CutterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Compress.Controls">
    <Grid>
        <!-- ================= Empty state ================= -->
        <Grid x:Name="EmptyView">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,30">
                <controls:DropZone Title="Drop a video to cut" ButtonText="Select Video" Pick="SelectVideo_Click" />
                <TextBlock x:Name="EmptyError" Foreground="{StaticResource Danger}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                           MaxWidth="460" HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- ================= Editor ================= -->
        <Grid x:Name="EditorView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Grid Margin="34,30,34,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Video -->
                <Grid x:Name="PlayerHost" SizeChanged="PlayerHost_SizeChanged">
                    <controls:VideoPlayer x:Name="Player" Width="640" Height="360" VerticalAlignment="Top" HorizontalAlignment="Center"
                                          PositionChanged="Player_PositionChanged" />
                </Grid>

                <!-- Timeline -->
                <StackPanel Grid.Row="1" Margin="0,22,0,0">
                    <Grid Margin="16,0,16,8">
                        <TextBlock x:Name="FileTitle" Foreground="#D4D4D4" FontSize="13.5" TextTrimming="CharacterEllipsis" Margin="0,0,200,0" />
                        <TextBlock x:Name="FileMeta" Foreground="{StaticResource Text3}" FontSize="12.5" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid x:Name="Timeline" Height="76" Background="Transparent" Cursor="Hand"
                          MouseLeftButtonDown="Timeline_MouseDown" MouseMove="Timeline_MouseMove" MouseLeftButtonUp="Timeline_MouseUp"
                          MouseWheel="Timeline_MouseWheel">
                        <Border x:Name="FilmHost" Margin="16,6" CornerRadius="10" Background="#141414" SizeChanged="FilmHost_SizeChanged">
                            <Grid x:Name="FilmClip">
                                <Canvas x:Name="FilmCanvas" />
                                <TextBlock x:Name="FilmLoading" Text="Loading preview…" Foreground="{StaticResource Text3}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Canvas x:Name="Overlay" Margin="16,0">
                            <Rectangle x:Name="DimLeft" Fill="#C80A0A0A" Height="64" Canvas.Top="6" IsHitTestVisible="False" />
                            <Rectangle x:Name="DimRight" Fill="#C80A0A0A" Height="64" Canvas.Top="6" IsHitTestVisible="False" />
                            <Border x:Name="Selection" Height="76" Canvas.Top="0" BorderBrush="{StaticResource Accent}" BorderThickness="0,3,0,3"
                                    IsHitTestVisible="False" />
                            <!-- Where a lossless cut really starts (nearest keyframe) -->
                            <Rectangle x:Name="KeyframeMarker" Width="2" Height="64" Canvas.Top="6" Fill="{StaticResource Warning}"
                                       IsHitTestVisible="False" Visibility="Collapsed" />
                            <Thumb x:Name="StartHandle" Style="{StaticResource TrimHandle}" Tag="8,0,0,8" ToolTip="Drag to set the start"
                                   DragStarted="Handle_DragStarted" DragDelta="Handle_DragDelta" DragCompleted="Handle_DragCompleted" />
                            <Thumb x:Name="EndHandle" Style="{StaticResource TrimHandle}" Tag="0,8,8,0" ToolTip="Drag to set the end"
                                   DragStarted="Handle_DragStarted" DragDelta="Handle_DragDelta" DragCompleted="Handle_DragCompleted" />
                            <Grid x:Name="Playhead" Canvas.Top="-5" IsHitTestVisible="False">
                                <Border Width="2" Height="86" Background="White" CornerRadius="1" />
                                <Ellipse Width="10" Height="10" Fill="White" VerticalAlignment="Top" Margin="0,-3,0,0" />
                            </Grid>
                        </Canvas>
                    </Grid>

                    <!-- Zoom: overview of the whole video (bright part = what the timeline shows) + zoom buttons -->
                    <Grid Margin="16,6,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="ZoomNav" Height="18" Margin="0,0,14,0" Background="Transparent" Cursor="SizeWE" Visibility="Hidden"
                              ToolTip="Drag to move along the video" SizeChanged="ZoomNav_SizeChanged" MouseWheel="Timeline_MouseWheel"
                              MouseLeftButtonDown="ZoomNav_MouseDown" MouseMove="ZoomNav_MouseMove" MouseLeftButtonUp="ZoomNav_MouseUp">
                            <Border Height="6" CornerRadius="3" Background="{StaticResource Surface2}" />
                            <Canvas x:Name="ZoomNavCanvas" IsHitTestVisible="False">
                                <Rectangle x:Name="ZoomNavSelection" Height="6" Canvas.Top="6" Fill="{StaticResource AccentSoft}" />
                                <Border x:Name="ZoomNavThumb" Height="10" Canvas.Top="4" CornerRadius="5" Background="#6E6E6E" />
                            </Canvas>
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource ChipButton}" Content="&#xE71F;" FontFamily="{StaticResource IconFont}"
                                    ToolTip="Zoom out  (-)" Click="ZoomOut_Click" />
                            <Button x:Name="ZoomMenuButton" Style="{StaticResource ChipButton}" ToolTip="Choose a zoom level">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ZoomText" Text="1×" MinWidth="30" TextAlignment="Center" />
                                    <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" Margin="6,1,0,0" />
                                </StackPanel>
                            </Button>
                            <Popup x:Name="ZoomPopup" PlacementTarget="{Binding ElementName=ZoomMenuButton}" Placement="Top" VerticalOffset="-6"
                                   AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="#121212" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="12" Padding="5"
                                        MinWidth="120" Margin="0,0,10,10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Color="Black" />
                                    </Border.Effect>
                                    <StackPanel x:Name="ZoomOptions" />
                                </Border>
                            </Popup>
                            <Button Style="{StaticResource ChipButton}" Content="&#xE8A3;" FontFamily="{StaticResource IconFont}"
                                    ToolTip="Zoom in  (+ or mouse wheel)" Click="ZoomIn_Click" />
                            <Button x:Name="ZoomFitButton" Style="{StaticResource ChipButton}" Content="Fit" Margin="0"
                                    ToolTip="Show the whole video  (0)" Click="ZoomFit_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Start / length / end -->
                    <Grid Margin="16,16,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="START" Style="{StaticResource Label}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ChipButton}" Content="&#xE76B;" FontFamily="{StaticResource IconFont}" Tag="start:-1"
                                        ToolTip="One frame earlier" Click="Nudge_Click" />
                                <TextBox x:Name="StartBox" Style="{StaticResource TimeInput}" KeyDown="TimeBox_KeyDown" LostFocus="TimeBox_LostFocus" />
                                <Button Style="{StaticResource ChipButton}" Content="&#xE76C;" FontFamily="{StaticResource IconFont}" Tag="start:1"
                                        ToolTip="One frame later" Click="Nudge_Click" Margin="6,0,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource LinkButton}" Content="Set to playhead  (I)" FontSize="12" HorizontalAlignment="Left"
                                    Margin="-4,6,0,0" Click="SetStart_Click" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="LENGTH" Style="{StaticResource Label}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="LengthText" Text="0.00 s" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="24"
                                       HorizontalAlignment="Center" Margin="0,-2,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <Button Style="{StaticResource ChipButton}" Click="PlaySelection_Click" ToolTip="Play only the selected part">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0" />
                                        <TextBlock Text="Play selection" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ResetButton" Style="{StaticResource ChipButton}" Content="Reset" Click="Reset_Click" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="END" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ChipButton}" Content="&#xE76B;" FontFamily="{StaticResource IconFont}" Tag="end:-1"
                                        ToolTip="One frame earlier" Click="Nudge_Click" />
                                <TextBox x:Name="EndBox" Style="{StaticResource TimeInput}" KeyDown="TimeBox_KeyDown" LostFocus="TimeBox_LostFocus" />
                                <Button Style="{StaticResource ChipButton}" Content="&#xE76C;" FontFamily="{StaticResource IconFont}" Tag="end:1"
                                        ToolTip="One frame later" Click="Nudge_Click" Margin="6,0,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource LinkButton}" Content="Set to playhead  (O)" FontSize="12" HorizontalAlignment="Right"
                                    Margin="0,6,-4,0" Click="SetEnd_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Side panel -->
            <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <Grid Margin="20,26,20,24">

                        <!-- Settings -->
                        <StackPanel x:Name="SettingsPanel">
                            <TextBlock Text="Cut" Style="{StaticResource Heading}" Margin="0,0,0,18" />

                            <RadioButton x:Name="FastRadio" Style="{StaticResource PresetCard}" GroupName="CutterMode" IsChecked="True" Checked="Options_Changed">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Fast" Style="{StaticResource CardTitle}" />
                                        <Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="LOSSLESS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Instant, original quality. The start snaps to the nearest keyframe, so it can begin a moment early."
                                               Style="{StaticResource CardText}" />
                                </StackPanel>
                            </RadioButton>
                            <TextBlock x:Name="KeyframeNote" Style="{StaticResource CardText}" Margin="4,-2,4,12" Visibility="Collapsed" />
                            <RadioButton x:Name="PreciseRadio" Style="{StaticResource PresetCard}" GroupName="CutterMode" Checked="Options_Changed">
                                <StackPanel>
                                    <TextBlock Text="Precise" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Frame-accurate cut. Re-encodes the clip in high quality, which takes longer."
                                               Style="{StaticResource CardText}" />
                                </StackPanel>
                            </RadioButton>

                            <Grid Margin="2,6,0,16">
                                <StackPanel>
                                    <TextBlock Text="Remove audio" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Text="Export a silent clip." FontSize="12" Foreground="{StaticResource Text3}" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="RemoveAudioSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Click="Options_Changed" />
                            </Grid>

                            <!-- One row per audio track (game, mic, …): mute + volume, heard live in the preview -->
                            <StackPanel x:Name="TracksPanel" Visibility="Collapsed" Margin="0,0,0,16">
                                <TextBlock Text="AUDIO TRACKS" Style="{StaticResource Label}" />
                                <StackPanel x:Name="TrackRows" />
                                <TextBlock x:Name="TracksNote" Style="{StaticResource CardText}" Foreground="{StaticResource Warning}" Margin="2,4,0,0"
                                           Text="All tracks are muted, so the clip will be silent." Visibility="Collapsed" />
                            </StackPanel>

                            <controls:SaveModeSelector x:Name="SaveMode" NewFileHint="The original stays as it is; the clip is saved with &quot;_cut&quot; added to the name."
                                                       ReplaceHint="The clip takes the original's name. The original goes to the Recycle Bin." />

                            <Border Style="{StaticResource Tile}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Clip length" Style="{StaticResource TileLabel}" />
                                        <TextBlock x:Name="SummaryLength" Text="—" Style="{StaticResource TileValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="Estimated size" Style="{StaticResource TileLabel}" HorizontalAlignment="Right" />
                                        <TextBlock x:Name="SummarySize" Text="—" Style="{StaticResource TileValue}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Button x:Name="CutButton" Style="{StaticResource WhiteButton}" AutomationProperties.Name="Cut video" Click="CutButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Cut video" />
                                    <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="12" Margin="10,1,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource LinkButton}" Content="Choose another video" HorizontalAlignment="Center" Margin="0,10,0,0"
                                    Click="SelectVideo_Click" />

                            <Border Style="{StaticResource Tile}" Margin="0,24,0,0" Background="Transparent">
                                <StackPanel>
                                    <TextBlock Text="SHORTCUTS" Style="{StaticResource Label}" />
                                    <TextBlock Foreground="{StaticResource Text3}" FontSize="12" LineHeight="20" TextWrapping="Wrap"
                                               Text="Space  play / pause&#10;I / O  set start / end at playhead&#10;← / →  1 second back / forward&#10;, / .  one frame back / forward&#10;Wheel or + / -  zoom the timeline&#10;Shift + wheel  scroll · 0  whole video" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Progress -->
                        <controls:ProgressView x:Name="ProgressPanel" Title="Cutting" Visibility="Collapsed" CancelRequested="Progress_CancelRequested" />

                        <!-- Done -->
                        <StackPanel x:Name="DonePanel" Visibility="Collapsed">
                            <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource AccentSoft}" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource Accent}" />
                            </Border>
                            <TextBlock Text="Cut complete" Style="{StaticResource Heading}" Margin="0,16,0,0" />
                            <TextBlock x:Name="DoneFileText" Style="{StaticResource CardText}" Margin="0,6,0,20" />

                            <Border Style="{StaticResource Tile}" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Length" Style="{StaticResource TileLabel}" />
                                        <TextBlock x:Name="DoneLength" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="28"
                                                   Foreground="{StaticResource Accent}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="Size" Style="{StaticResource TileLabel}" HorizontalAlignment="Right" />
                                        <TextBlock x:Name="DoneSize" Style="{StaticResource TileValue}" FontSize="18" HorizontalAlignment="Right" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="DoneDetails" Style="{StaticResource CardText}" Foreground="{StaticResource Text3}" Margin="2,10,2,0" />

                            <Button Style="{StaticResource WhiteButton}" Margin="0,20,0,0" Click="ShowInFolder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xED25;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="Show in folder" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Margin="0,10,0,0" Click="CopyFile_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="CopyFileIcon" Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock x:Name="CopyFileText" Text="Copy file (paste into Discord)" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Margin="0,10,0,0" Click="SendToCompress_Click"
                                    ToolTip="Open the cut clip on the Compress page">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73F;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Accent}" Margin="0,0,10,0" />
                                    <TextBlock Text="Compress this clip" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource LinkButton}" Content="Cut another part" HorizontalAlignment="Center" Margin="0,10,0,0" Click="BackToSettings_Click" />
                        </StackPanel>

                        <!-- Error -->
                        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                            <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource DangerSoft}" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Danger}" />
                            </Border>
                            <TextBlock x:Name="ErrorTitle" Text="Cut failed" Style="{StaticResource Heading}" Margin="0,16,0,0" TextWrapping="Wrap" />
                            <Border Style="{StaticResource Tile}" Margin="0,16,0,0">
                                <TextBox x:Name="ErrorText" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource Text2}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" MaxHeight="260"
                                         VerticalScrollBarVisibility="Auto" />
                            </Border>
                            <Button Style="{StaticResource WhiteButton}" Content="Back" Margin="0,20,0,0" Click="BackToSettings_Click" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
